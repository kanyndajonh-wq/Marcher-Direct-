<!DOCTYPE html>
<html>
<head>
    <title>Marcher-Direct - Connexion</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex items-center justify-center h-screen">
    <div class="bg-white p-8 rounded-lg shadow-md w-96">
        <h2 class="text-2xl font-bold mb-6 text-center">Connexion</h2>
        <form>
            <input type="email" placeholder="Email" class="w-full p-3 mb-4 border rounded">
            <input type="password" placeholder="Mot de passe" class="w-full p-3 mb-4 border rounded">
            <button class="w-full bg-green-600 text-white p-3 rounded font-bold">Se connecter</button>
        </form>
        <p class="text-center mt-4">Pas de compte ? <a href="index.html" class="text-green-600">S'inscrire</a></p>
    </div>
</body>
</html>
